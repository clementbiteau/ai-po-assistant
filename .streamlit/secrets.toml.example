# Paste this (with real values) into Streamlit Community Cloud:
#   App › Settings › Secrets
# Root-level keys are exposed to the app as environment variables.

ANTHROPIC_API_KEY = "sk-ant-..."
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_KEY = "sb_publishable_..."   # publishable / anon key — never the service_role key
USD_TO_EUR = "0.86"
ANTHROPIC_CREDITS_USD = "10"          # credit loaded on the Claude Console (remaining-credit estimate)
