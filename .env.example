# ── Claude (required for live runs; the offline demo works without it) ──
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# ── Authentication ──
# supabase (default, production) — the app stays locked until both values are set
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=sb_publishable_...          # publishable / anon key, NEVER the service_role key

# local (development only): SQLite users admin@local.dev + demo@local.dev
# AUTH_MODE=local
# LOCAL_DEV_PASSWORD=choose-a-local-password

# ── Cost reporting ──
# ANTHROPIC_CREDITS_USD=10          # credit loaded on the Claude Console → remaining-credit estimate
# USD_TO_EUR=0.86
# APP_TIMEZONE=Europe/Paris

# ── Optional tuning ──
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_TIMEOUT_S=180
# ANTHROPIC_MAX_RETRIES=2
# STORY_WORKERS=4
# EFFORT_ANALYST=medium
# EFFORT_STRATEGIST=high
# EFFORT_WRITER=medium
